# The null backend verifies frame flow without touching USB hardware. A real
# adapter backend must be selected explicitly; there is no transport fallback.
USBDISPLAY_BACKEND=/usr/lib/usbdisplay/usbdisplay-null.so

# Example PPM diagnostic output:
# USBDISPLAY_BACKEND=/usr/lib/usbdisplay/usbdisplay-ppm.so
# USBDISPLAY_BACKEND_ARGS=--backend-option /tmp/usbdisplay.ppm

# Actions Micro 185b:2d1d (requires ffmpeg with libx264 and an authorized
# replay template containing initialization and heartbeat commands).
# bootstrap=full is required for the reopen path to reactivate the firmware
# after a USB reset; without it only the initialization subset is replayed:
# USBDISPLAY_BACKEND=/usr/lib/usbdisplay/usbdisplay-actions-micro.so
# USBDISPLAY_BACKEND_ARGS=--backend-option template=/var/lib/usbdisplay/actions-micro.replay,bootstrap=full
USBDISPLAY_BACKEND_ARGS=
