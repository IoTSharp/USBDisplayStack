[Unit]
Description=USBDisplayStack frame transport daemon
After=systemd-modules-load.service
ConditionPathExists=/dev/usbdisplay0

[Service]
Type=simple
RuntimeDirectory=usbdisplay
RuntimeDirectoryMode=0755
Environment=USBDISPLAY_BACKEND=/usr/lib/usbdisplay/usbdisplay-null.so
Environment=USBDISPLAY_BACKEND_ARGS=
EnvironmentFile=-/etc/default/usb-displayd
ExecStartPre=/bin/rm -f /run/usbdisplay/ready
ExecStart=/usr/bin/usb-displayd --device /dev/usbdisplay0 --backend ${USBDISPLAY_BACKEND} $USBDISPLAY_BACKEND_ARGS --ready-file /run/usbdisplay/ready --retry-ms 2000
Restart=on-failure
RestartSec=2
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
